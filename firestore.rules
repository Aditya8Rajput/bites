rules_version = '2';

// ===============================================================
// Production Security Architecture for Bites (1-on-1 WebRTC)
// ===============================================================
//
// Collection: users/{userId}
// - Only the authenticated owner can get their own document. Listing all users is disabled.
// - Creation requires matching auth.uid and auth email.
// - isVerified cannot be set to true unless request.auth.token.email_verified == true.
//
// Collection: match_queue/{userId}
// - Only authenticated users can list waiting peers to find matches.
// - Users can create their own ticket with status 'waiting' or 'matched'.
// - Updates allowed for ticket owner OR when another authenticated user locks a match.
// - Deletions allowed for ticket owner (leave/cancel) or stale cleanup (> 20s).
//
// Collection: matches/{matchId}
// - Only the two matched participants (initiator & receiver) can read the match.
// - Only the initiator can create the match with status 'active'.
// - Participants can update status to 'ended' without altering participant UIDs.
// - Listing and deletion are disabled.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(matchData) {
      return isAuthenticated() && (
        request.auth.uid == matchData.initiatorUid ||
        request.auth.uid == matchData.receiverUid
      );
    }

    // Default deny for all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Users Collection
    // -------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && (
          !('isVerified' in request.resource.data) ||
          request.resource.data.isVerified == false ||
          request.auth.token.email_verified == true
        );

      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && (
          !('isVerified' in request.resource.data) ||
          request.resource.data.isVerified == resource.data.isVerified ||
          (request.resource.data.isVerified == true && request.auth.token.email_verified == true)
        );

      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Matchmaking Queue Collection
    // -------------------------------------------------------------
    match /match_queue/{userId} {
      // Authenticated users can list waiting peers and get candidate ticket
      allow list: if isAuthenticated();
      allow get: if isAuthenticated();

      // Users create their own queue ticket
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.status in ["waiting", "matched"];

      // Ticket owner can update their ticket OR another authenticated peer
      // can atomically transition status from 'waiting' to 'matched'
      allow update: if isAuthenticated() && (
        isOwner(userId) ||
        (resource.data.status == "waiting" && request.resource.data.status == "matched")
      );

      // Ticket owner can delete their ticket when leaving or skipping,
      // or cleanup stale tickets older than 20 seconds
      allow delete: if isAuthenticated() && (
        isOwner(userId) ||
        (request.time.toMillis() - resource.data.createdAt > 20000)
      );
    }

    // -------------------------------------------------------------
    // Matches Collection
    // -------------------------------------------------------------
    match /matches/{matchId} {
      // Only the two matched participants can read their match session
      allow get: if isParticipant(resource.data);
      allow list: if false;

      // The initiator creates the active match document
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.initiatorUid
        && request.resource.data.status == "active";

      // Either participant can update status to 'ended' (e.g. skip / leave)
      allow update: if isParticipant(resource.data)
        && request.resource.data.initiatorUid == resource.data.initiatorUid
        && request.resource.data.receiverUid == resource.data.receiverUid;

      allow delete: if false;
    }
  }
}
